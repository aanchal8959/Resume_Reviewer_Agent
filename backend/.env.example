# --- LLM provider (choose one: gemini | openrouter) ---
LLM_PROVIDER=gemini
# Gemini (when LLM_PROVIDER=gemini)
# Get a free key at https://aistudio.google.com/api/key
GEMINI_API_KEY=
MODEL_NAME=gemini-3-flash-preview
LLM_TIMEOUT_SECONDS=60
# OpenRouter (when LLM_PROVIDER=openrouter) — any OpenAI-compatible model
# Get a key at https://openrouter.ai/keys — change model freely
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=Job Switch Agent
# OPENROUTER_TIMEOUT_SECONDS=60

# --- Database ---
DATABASE_URL=sqlite:///./job_switch_agent.db

# --- REAL-TIME JOB SOURCES (free/public APIs; enable what you want) ---
ENABLE_REMOTIVE=true
ENABLE_ARBEITNOW=false
ENABLE_JOBICY=false
# ADZUNA_APP_ID=
# ADZUNA_API_KEY=
# GREENHOUSE_COMPANIES=stripe:Stripe Inc,datadog

PROVIDER_TIMEOUT_SECONDS=10
MAX_PROVIDER_RETRIES=2
JOB_CACHE_TTL_MINUTES=60
URL_VERIFY_TTL_HOURS=24
URL_VERIFY_MAX_PER_SEARCH=10
JOB_STALE_DAYS=30

# --- Roadmap / scoring ---
ROADMAP_DAYS=30
DAILY_STUDY_HOURS=2
MATCH_WEIGHTS_JSON={"required_skills":0.50,"preferred_skills":0.20,"experience":0.15,"project_relevance":0.10,"education":0.05}
JOB_MATCH_WEIGHTS_JSON={"required_skill_match":0.35,"preferred_skill_match":0.15,"role_match":0.15,"experience_match":0.15,"location_match":0.10,"salary_match":0.10}

# --- LangSmith tracing (optional) ---
# Enable at https://smith.langchain.com — tracing is off by default.
# LANGSMITH_TRACING=true
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=job-switch-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_TRACING_V2 is an alias for LANGSMITH_TRACING.

# --- Arize Phoenix tracing (optional, local) ---
# Run locally: docker run -p 6006:6006 -p 4317:4317 arizephoenix/phoenix
# View at http://localhost:6006 — traces for all 3 LangGraph pipelines
# PHOENIX_TRACING=true
# PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROJECT=job-switch-agent

# --- API ---
CORS_ORIGINS=http://localhost:3000
