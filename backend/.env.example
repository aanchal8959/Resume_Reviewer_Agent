# --- LLM: Gemini (required) ---
# Get a free key at https://aistudio.google.com/api/key
GEMINI_API_KEY=
MODEL_NAME=gemini-3-flash-preview
LLM_TIMEOUT_SECONDS=60

# --- Database ---
DATABASE_URL=sqlite:///./job_switch_agent.db

# --- REAL-TIME JOB SOURCES (free/public APIs; enable what you want) ---
ENABLE_REMOTIVE=true
ENABLE_ARBEITNOW=false
ENABLE_JOBICY=false
# ADZUNA_APP_ID=
# ADZUNA_API_KEY=
# GREENHOUSE_COMPANIES=stripe:Stripe Inc,datadog

PROVIDER_TIMEOUT_SECONDS=10
MAX_PROVIDER_RETRIES=2
JOB_CACHE_TTL_MINUTES=60
URL_VERIFY_TTL_HOURS=24
URL_VERIFY_MAX_PER_SEARCH=10
JOB_STALE_DAYS=30

# --- Roadmap / scoring ---
ROADMAP_DAYS=30
DAILY_STUDY_HOURS=2
MATCH_WEIGHTS_JSON={"required_skills":0.50,"preferred_skills":0.20,"experience":0.15,"project_relevance":0.10,"education":0.05}
JOB_MATCH_WEIGHTS_JSON={"required_skill_match":0.35,"preferred_skill_match":0.15,"role_match":0.15,"experience_match":0.15,"location_match":0.10,"salary_match":0.10}

# --- API ---
CORS_ORIGINS=http://localhost:3000
